# syntax=docker/dockerfile:1
# Imagen de desarrollo — usada solo por docker-compose.yml (hot-reload,
# node_modules como volúmenes nombrados, código montado en vivo).
# No usar para producción: ver Dockerfile en la raíz.

ARG NODE_VERSION=22.18.0
FROM docker.io/library/node:${NODE_VERSION}-slim

WORKDIR /app

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y openssl && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

# El .npmrc entra ANTES del install: trae los margenes de red que el build
# del VPS necesita para que el chequeo de cadena de suministro no expire.
COPY .npmrc pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/reglas/package.json packages/reglas/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

# Mismo cache mount que el Dockerfile de produccion, y por el mismo motivo: sin
# el, un build interrumpido en el VPS tira los 14 minutos de descargas y el
# siguiente empieza de cero. Ver el comentario largo alla.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

COPY . .

RUN pnpm --filter @pv/api exec prisma generate

RUN chmod +x bin/docker-entrypoint.dev
ENTRYPOINT ["/app/bin/docker-entrypoint.dev"]
CMD ["pnpm", "dev"]
