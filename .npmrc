# Márgenes de red para el build en el VPS.
#
# El 2026-07-29 el deploy falló dos veces seguidas, las dos en
# `pnpm install --frozen-lockfile`, con:
#
#   ✗ Lockfile failed supply-chain policy check (491 entries in 14m 2.7s)
#   [ERR_PNPM_BROKEN_METADATA_JSON] The operation was aborted due to timeout
#
# pnpm 11 valida el lockfile entero contra el registro antes de instalar. Desde
# la conexión del VPS eso son 491 peticiones de metadata con tarballs bajando a
# 3 KiB/s y respuestas de 45 segundos: con los valores por defecto no termina.
#
# No se desactiva el chequeo. Es una guarda de cadena de suministro y apagarla
# para que un build pase es exactamente el trato que no conviene hacer — lo que
# se sube es el tiempo que se le da para completarse.
fetch-timeout=300000
fetch-retries=5
fetch-retry-maxtimeout=120000

# Menos peticiones en paralelo. Suena al revés, y no lo es: con un enlace
# saturado, 16 descargas simultáneas a 3 KiB/s cada una hacen que TODAS se
# acerquen al timeout. Menos concurrencia deja que cada una termine.
network-concurrency=4
