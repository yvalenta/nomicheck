#!/bin/bash -e

# Los node_modules son volúmenes nombrados vacíos en el primer `docker
# compose up` (montan por encima de lo instalado en build time), así que
# hay que reinstalar aquí, no solo en el Dockerfile. El store de pnpm
# también es un volumen nombrado, así que las reinstalaciones tras la
# primera son casi instantáneas (todo viene del cache de contenido).
pnpm install --frozen-lockfile --store-dir "${PNPM_STORE_DIR:-/pnpm-store}"

# El cliente de Prisma se genera dentro de node_modules; como ese
# directorio acaba de reinstalarse, hay que regenerarlo en cada arranque.
pnpm --filter @pv/api exec prisma generate

# ── La web ───────────────────────────────────────────────────────────────────
#
# `apps/api/src/index.ts` sirve `apps/api/web-dist` cuando existe: un contenedor,
# un puerto, sin separacion api/web en runtime. Hasta el 2026-08-03 ese
# directorio no lo construia nadie, asi que `/`, `/servicios` y `/docs/` daban
# 404 mientras la API funcionaba — la web existia en el repo y no en el mundo.
#
# Va ACA y no en el Dockerfile porque Vite hornea las `VITE_*` en el bundle en
# tiempo de build, y esas variables llegan por el `env_file` del servicio, que
# solo existe en runtime. Meterlo en el Dockerfile exigiria `build.args` en el
# compose del VPS — el mismo archivo fuera de los repos que ya nos mordio con
# `GIT_SHA`.
if [[ -n "${VITE_SUPABASE_URL:-}" && -n "${VITE_SUPABASE_ANON_KEY:-}" ]]; then
  # NUNCA fatal. Este script corre con `-e` y es el PID 1 del contenedor: un
  # `tsc` en rojo mataba el arranque entero y con el la API, el muro x402 y el
  # verificador publico. Paso el 2026-08-03 — la web es secundaria y no puede
  # llevarse puesto el riel de cobro. Si falla, se dice y se sigue sin web.
  #
  # `@pv/reglas` va ANTES: la web lo importa, y el `command:` del compose que lo
  # construye corre DESPUES de este entrypoint (`exec "${@}"` es la ultima
  # linea). Sin esto, `tsc -b` no encuentra sus tipos y falla siempre.
  if pnpm --filter @pv/reglas build && pnpm --filter @pv/web build; then
    rm -rf apps/api/web-dist
    cp -r apps/web/dist apps/api/web-dist
    echo "[web] servida desde apps/api/web-dist"
  else
    echo "[web] EL BUILD FALLO — la API arranca igual, sin web." >&2
    echo "[web] Se sirve /api normalmente; /, /servicios y /docs/ daran 404." >&2
  fi
else
  # No se construye a medias: `createClient(undefined, ...)` revienta al cargar
  # el modulo, y como `supabase.ts` se importa estatico desde App.tsx eso rompe
  # el bundle ENTERO — incluidas las paginas que no usan Supabase. Un 404 se
  # diagnostica; una pagina en blanco por un throw en el import, no.
  echo "[web] SIN CONSTRUIR: faltan VITE_SUPABASE_URL y/o VITE_SUPABASE_ANON_KEY." >&2
  echo "[web] La API sigue sirviendo /api; la web va a dar 404 hasta que esten." >&2
fi

exec "${@}"
