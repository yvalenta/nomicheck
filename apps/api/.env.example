DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
PORT=3001
IA_PROVEEDOR=gemini
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=cambia-esto-en-produccion
# Requests por minuto por IP al wrapper /api/batch (default 60). El bucket es
# por IP: detrás del proxy, muchos agentes de un mismo integrador comparten
# egress — esto se sube en operación sin redeploy.
BATCH_RATE_LIMIT_POR_MINUTO=60

# ── Muro de pago x402 ───────────────────────────────────────────────────────
#
# X402_ACTIVO enciende el muro (default false; el resto de sus variables —
# X402_PAY_TO, X402_RED, X402_FACILITATOR* — está documentado en
# src/lib/x402Config.ts). DX402_ACTIVO es una flag APARTE para
# /verificar/durable (DX402 punto 2, el sobre anclado): default false, y
# apagada esa ruta no existe —no cobra, no sale en pricing ni en OpenAPI, y
# su GET /verificar/durable/sobre-publickey da 404— ni se exige su
# configuración al arrancar (NOMICHECK_SOBRE_SIGNING_KEY_PEM, avalanche en
# X402_RED). Así main se despliega sin la llave del sobre y DX402 se enciende
# después, con la llave puesta. Solo tiene efecto con X402_ACTIVO=true.
DX402_ACTIVO=false

# ── Cuenta de cobro (`pnpm cobro`) ──────────────────────────────────────────
#
# Quién cobra. NO tienen valor por defecto y el script se niega a emitir sin
# ellos: una cuenta de cobro con la identificación de otro, o sin cuenta a dónde
# consignar, es peor que no tener documento.
#
# Van en `.env` (que está en .gitignore), nunca acá con valores reales:
# IDENTIFICACION es un documento de identidad y FORMA_DE_PAGO lleva una cuenta
# bancaria.
COBRO_EMISOR_NOMBRE="Nombre o razón social de quien cobra"
COBRO_EMISOR_IDENTIFICACION="cédula o NIT, con dígito de verificación si aplica"
COBRO_EMISOR_CORREO="a dónde responde el que recibe el cobro"
COBRO_EMISOR_FORMA_DE_PAGO="Banco, tipo de cuenta y número — texto libre, sale tal cual en el documento"
# Opcionales, solo cosméticos:
COBRO_EMISOR_CIUDAD="Medellín"
COBRO_EMISOR_TELEFONO="+57 ..."
