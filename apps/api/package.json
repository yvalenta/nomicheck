{
  "name": "@pv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "db:desechable": "bash scripts/base-desechable.sh",
    "cobro": "tsx scripts/cuenta-de-cobro.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@faremeter/middleware": "^0.22.0",
    "@prisma/client": "^5.22.0",
    "@pv/mcp": "workspace:*",
    "@pv/reglas": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "pg-boss": "^12.28.0",
    "prisma": "^5.22.0",
    "viem": "^2.55.19",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
