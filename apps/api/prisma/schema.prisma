generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReglaLegal {
  id           Int      @id @default(autoincrement())
  clave        String
  valor        Float
  vigenteDesde String // ISO date YYYY-MM-DD
  vigenteHasta String?
  fuente       String?
  creadoEn     DateTime @default(now())

  @@index([clave, vigenteDesde])
}

model Festivo {
  id     Int    @id @default(autoincrement())
  fecha  String @unique // YYYY-MM-DD
  nombre String
}

// Perfil de dominio 1:1 con auth.users de Supabase (id = mismo UUID).
// La identidad/credenciales viven en Supabase Auth, no aquí (SDD.md §07).
model Usuario {
  id        String   @id @db.Uuid
  nombre    String
  // Correo denormalizado desde Supabase Auth (allí viven las credenciales) —
  // permite buscar la cuenta por correo al invitar sin paginar todo Auth.
  email     String?  @unique
  // admin_plataforma | admin_empresa | analista_rrhh | auditor | colaborador | individual
  //
  // Roles dentro de una empresa (SDD §15, pilar 1):
  //   admin_empresa  → todo. Único que puede crear/borrar sedes, invitar y
  //                    liquidar. Ve todos los empleados de su empresa.
  //   analista_rrhh  → operativo. Ve/edita SOLO empleados de las sedes en
  //                    UsuarioSede; sin sedes asignadas se comporta como
  //                    admin_empresa (una empresa chica sin sedes sigue
  //                    funcionando). Puede liquidar. NO invita ni borra.
  //   auditor        → solo lectura de todo lo de su empresa. Cualquier POST/PUT/
  //                    DELETE le devuelve 403 (middleware bloqueaEscritura).
  //
  // OJO: este campo ya NO es el rol efectivo dentro de una empresa. Desde
  // MembresiaEmpresa, el rol con el que se resuelve cada request sale de la
  // membresía (usuarioId, empresaId activa) — una misma cuenta puede ser
  // admin_empresa en una y auditor en otra. Este `rol` queda como rol de
  // cuenta: sirve para admin_plataforma (que no tiene membresías) y como
  // valor de arranque al crear la primera membresía.
  rol       String
  // Empresa ACTIVA actual (puntero denormalizado, no la pertenencia). La
  // pertenencia vive en MembresiaEmpresa; esto solo dice "en cuál de mis
  // empresas estoy parado ahora", y se valida contra la membresía en cada
  // request (requiereAuth): puntero sin membresía → 403, nunca acceso.
  // Null = sin empresa: recién registrado admin_plataforma, o colaborador
  // libre entre empresas.
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // Una cuenta se liga a varios Empleado a lo largo del tiempo (historial de
  // empresas) — solo uno "activo aceptado" a la vez (índice único parcial en
  // la migración). Ver invitacionAceptadaEn en Empleado.
  empleados      Empleado[]            @relation("EmpleadoUsuario")
  reportes       ReporteDiscrepancia[]
  liquidaciones  Liquidacion[]
  // Sedes asignadas a un analista_rrhh (many-to-many). Vacío = ve todas las
  // de su empresa (útil para empresas chicas sin sucursales).
  sedesAsignadas UsuarioSede[]
  // A qué empresas pertenece esta cuenta y con qué rol en cada una. Fuente de
  // verdad de la tenencia: `empresaId` de arriba es solo el puntero a la
  // activa, y tiene que estar en esta lista para valer.
  membresias     MembresiaEmpresa[]
  creadoEn       DateTime              @default(now())

  @@index([empresaId])
}

// Liquidación guardada por un usuario en su historial personal (flujo de
// "delayed auth" del verificador anónimo, SDD §13). Es un SNAPSHOT del
// ResultadoNomina calculado — no se recalcula al cambiar reglas, igual que
// ReciboPago. No pertenece a una empresa: la guarda una cuenta individual
// (o cualquier usuario autenticado) sobre su propio cálculo.
model Liquidacion {
  id           Int      @id @default(autoincrement())
  usuarioId    String   @db.Uuid
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  resultado    Json // ResultadoNomina completo (snapshot)
  netoEsperado Float // denormalizado desde resultado, para listar sin parsear el JSON
  netoRecibido Float? // lo que el usuario dijo haber recibido, si lo ingresó
  periodoDesde String? // YYYY-MM-DD, desde el snapshot
  periodoHasta String? // YYYY-MM-DD, desde el snapshot
  creadoEn     DateTime @default(now())

  // El listado del historial es siempre "las mías, más recientes primero" —
  // el índice compuesto sirve el ORDER BY sin sort aparte.
  @@index([usuarioId, creadoEn(sort: Desc)])
}

model Empresa {
  id             Int      @id @default(autoincrement())
  nombre         String
  nit            String   @unique
  sector         String
  creadoEn       DateTime @default(now())
  // Suspender bloquea de verdad el acceso (403 en requiereAuth) para
  // admin_empresa y colaboradores de esta empresa — admin_plataforma sigue
  // viendo/reactivando la empresa sin problema (SDD.md §03 Módulo D).
  activa         Boolean  @default(true)
  // Pago on-chain (SDD §17): dirección EVM desde la que la empresa firma los
  // lotes de USDC. REFERENCIAL — NomiCheck nunca controla esta wallet ni sus
  // fondos (modelo no-custodial); se usa para verificar el `from` del tx.
  walletPagadora String?
  // De dónde vino esta empresa: el `utm_*` de la campaña que la trajo, anotado
  // al registrarse y nunca después. `null` = llegó por su cuenta O se perdió el
  // rastro; NO se distingue, y decir "directo" sobre el segundo caso sería
  // inventar atribución.
  //
  // Existe en vez del Meta Pixel, que habría dado lo mismo rompiendo dos
  // promesas ya servidas: el verificador afirma que no carga scripts externos
  // ni analítica, y el FAQ de la landing promete que nadie más que el
  // trabajador ve su resultado. Ver `apps/web/src/lanzamiento/origenCampana.ts`.
  origen         String?

  // Cuentas que tienen a ESTA empresa como activa (puntero). Para saber quién
  // pertenece a la empresa se usa `membresias`, no esta lista: un admin de dos
  // empresas aparece aquí solo en la que está parado ahora mismo.
  usuarios     Usuario[]
  // Quién pertenece a esta empresa y con qué rol (fuente de verdad).
  membresias   MembresiaEmpresa[]
  empleados    Empleado[]
  contratistas Contratista[]
  periodos     PeriodoNomina[]
  sedes        Sede[]
  evidencias   EvidenciaCierre[]
}

// La fuente de verdad de "a qué empresas pertenece este usuario y con qué rol"
// (SDD §15). Antes la respuesta era `Usuario.empresaId` + `Usuario.rol`: una
// cuenta = una empresa, así que un admin de dos empresas necesitaba dos
// cuentas. Con esta tabla la pertenencia es N:M y el rol es POR EMPRESA — la
// misma persona puede ser admin_empresa en una y auditor en otra.
//
// El reparto de responsabilidades quedó así:
//   MembresiaEmpresa  → a cuáles pertenece y con qué rol (autorización).
//   Usuario.empresaId → en cuál está parado ahora (puntero a la activa).
// `requiereAuth` valida el puntero contra esta tabla en CADA request y saca de
// aquí el rol efectivo. Un puntero sin fila acá no da acceso: responde 403.
// Por eso el cambio de empresa activa no necesita re-login ni toca permisos.
model MembresiaEmpresa {
  usuarioId String   @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  // admin_empresa | analista_rrhh | auditor | colaborador — mismos nombres que
  // Usuario.rol (ver allí qué puede cada uno), pero acotado a esta empresa.
  // admin_plataforma NO se modela acá: no pertenece a ninguna empresa, y su
  // "ver como" entra por una membresía temporal explícita de rol auditor.
  rol       String
  creadoEn  DateTime @default(now())

  // Una sola fila por (cuenta, empresa): el rol de alguien en una empresa es
  // uno solo. La PK compuesta ya lo impone.
  @@id([usuarioId, empresaId])
  // Para "quiénes son los miembros de esta empresa" (pantalla de Roles) sin
  // escanear la tabla; el otro sentido lo sirve el prefijo de la PK.
  @@index([empresaId])
}

// Sucursal/departamento dentro de una empresa (SDD §15, pilar 1). Modelo
// mínimo: nombre + FK a empresa. Sirve para dos cosas:
//   1) Segmentar empleados (Empleado.sedeId opcional — sin sede = no está
//      asignado a ninguna sucursal, lo cual es válido para empresas chicas).
//   2) Scoping del rol analista_rrhh vía UsuarioSede.
model Sede {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nombre    String
  creadoEn  DateTime @default(now())

  empleados Empleado[]
  analistas UsuarioSede[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

// Tabla puente para el scoping del analista_rrhh. Sin filas para un usuario,
// se interpreta como "ve todas las sedes de su empresa" (ver comentario en
// Usuario.rol) — importante para no bloquear empresas sin sucursales.
model UsuarioSede {
  usuarioId String  @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sedeId    Int
  sede      Sede    @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, sedeId])
  @@index([sedeId])
}

model Empleado {
  id                   Int       @id @default(autoincrement())
  empresaId            Int
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  // FK a la cuenta que reclama este registro. NO es único: una cuenta puede
  // aparecer en varios Empleado (distintas empresas / épocas). La unicidad
  // "una empresa activa por cuenta" la impone un índice parcial en la migración.
  usuarioId            String?   @db.Uuid
  usuario              Usuario?  @relation("EmpleadoUsuario", fields: [usuarioId], references: [id])
  // Null con usuarioId seteado = invitación PENDIENTE (cuenta existente aún sin
  // aceptar). Con fecha = ACEPTADA (o vínculo directo de cuenta nueva). Doble
  // uso como auditoría de cuándo se unió.
  invitacionAceptadaEn DateTime?
  nombre               String
  documento            String
  salarioBase          Float
  tipoNomina           String // turnos | fijo
  auxilioTransporte    Boolean   @default(false)
  fechaIngreso         String // YYYY-MM-DD — base de antigüedad para prestaciones sociales
  fechaRetiro          String? // YYYY-MM-DD — si está seteada, el empleado puede liquidarse (prestacionesService)
  // indefinido (default) | fijo | obra_labor | tiempo_parcial | aprendizaje_sena_lectiva |
  // aprendizaje_sena_practica — ver TipoContrato en @pv/reglas.
  // "servicios" NO se modela aquí: no es contrato laboral (SDD §07).
  tipoContrato         String    @default("indefinido")
  // Clase de riesgo laboral ARL (I a V, Decreto 1772 de 1994) — 1 = riesgo
  // mínimo (oficinas/comercio). Antes solo existía como parámetro de
  // cálculo con default silencioso a 1 para todos; persistirla por
  // empleado es lo que hace "exacta" la liquidación PILA (packages/reglas
  // costoEmpleador.ts, calcularLiquidacionPilaEmpleado).
  claseRiesgoArl       Int       @default(1)
  // Sede/sucursal a la que pertenece — opcional. null = sin sede asignada
  // (empresa chica sin sucursales). Los analistas_rrhh con UsuarioSede
  // definido solo ven empleados con sedeId en su lista.
  sedeId               Int?
  sede                 Sede?     @relation(fields: [sedeId], references: [id])
  activo               Boolean   @default(true)
  // Pago on-chain (SDD §17): SOLO constancia complementaria — el salario
  // legal SIEMPRE se paga en COP (CST art. 134-136, moneda legal). Esta
  // wallet nunca entra a un BatchPago en fase 1; queda para registro
  // voluntario de pagos extralegales cuando la regulación lo permita.
  walletAddress        String?
  // Soft delete: `activo=false` es "retirado" (con fecha legal), `eliminadoEn`
  // es "creado por error, ocultar" — se conserva la fila para no romper FKs
  // de recibos/turnos históricos. Todas las lecturas filtran eliminadoEn IS NULL
  // por default (empleadosService.listar + empleadoAccesible).
  eliminadoEn          DateTime?
  creadoEn             DateTime  @default(now())

  turnos           Turno[]
  recibos          ReciboPago[]
  periodosIncluido PeriodoNominaEmpleado[]

  @@unique([empresaId, documento])
  @@index([empresaId])
  // Flujos del colaborador (invitaciones pendientes, historial de empresas)
  // buscan por usuarioId sin las condiciones del índice parcial
  // Empleado_usuario_activo_unico (que solo cubre activo + aceptado).
  @@index([usuarioId])
  // Scoping del analista_rrhh: listar/validar empleados por sede.
  @@index([sedeId])
}

// Contratista de prestación de servicios (Ley 1819 de 2016, art. 244) — NO
// es Empleado: no tiene contrato laboral, así que no tiene fechaIngreso/
// tipoNomina/auxilio ni genera prestaciones sociales (SDD §07).
model Contratista {
  id                  Int      @id @default(autoincrement())
  empresaId           Int
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  nombre              String
  documento           String
  honorariosMensuales Float
  // Pago on-chain (SDD §17): dirección EVM 0x… donde recibe USDC. Opt-in —
  // null = el contratista se paga por fuera y no entra a los lotes.
  walletAddress       String?
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now())

  recibos ReciboPago[]

  @@unique([empresaId, documento])
  @@index([empresaId])
}

model PeriodoNomina {
  id                 Int       @id @default(autoincrement())
  empresaId          Int
  empresa            Empresa   @relation(fields: [empresaId], references: [id])
  fechaInicio        String // YYYY-MM-DD
  fechaFin           String // YYYY-MM-DD
  // borrador | liquidando | liquidado | liquidado_con_rechazos | fallido | pagado
  // Máquina de estados (SDD §15, escalabilidad enterprise):
  //   borrador → liquidando → (liquidado | liquidado_con_rechazos | fallido)
  //   liquidado / liquidado_con_rechazos ↔ borrador (revertirABorrador)
  //   liquidado → pagado (transición futura, no implementada aún)
  // `liquidando` bloquea toda edición mientras el worker procesa lotes.
  // `liquidado_con_rechazos` = liquidación parcial: los empleados que pasaron
  // QA quedaron con recibo; los rechazados quedan reportados en
  // `erroresLiquidacion` sin recibo — permite revisar y volver a intentar
  // solo esos, en vez de bloquear al resto del payroll a esta escala.
  estado             String    @default("borrador")
  creadoEn           DateTime  @default(now())
  // Rastro de auditoría de la última edición de fechas (solo se permite en
  // borrador — un periodo liquidado se revierte primero). Null = nunca editado.
  notaEdicion        String?
  editadoEn          DateTime?
  // Concurrencia optimista: cada write bumpea version. liquidarPeriodo /
  // revertirABorrador exigen where {id, version: X} y capturan P2025 como
  // ErrorConflicto (HTTP 409) — evita que dos analistas pisen el mismo
  // periodo simultáneamente. Los updates de PROGRESO del worker asincrónico
  // NO usan version (son escritura de sistema monótona, protegida por el
  // hecho de que solo el job dueño de jobId escribe mientras estado='liquidando');
  // las TRANSICIONES de estado (→liquidando, →liquidado*, →fallido) sí van con
  // version para detectar ediciones concurrentes reales.
  version            Int       @default(0)
  // Liquidación asíncrona (SDD §15, escalabilidad enterprise). Null cuando el
  // periodo nunca se encoló; se rellena al transicionar a `liquidando`.
  jobId              String?
  progreso           Int       @default(0)
  // Cuando el periodo termina en `liquidado_con_rechazos` o `fallido`, aquí
  // queda el detalle tipado — { empleadoId, nombre, issues[] } para rechazos
  // por-empleado (QA), o { mensaje, contexto } para fallo catastrófico.
  erroresLiquidacion Json?

  turnos             Turno[]
  recibos            ReciboPago[]
  empleadosIncluidos PeriodoNominaEmpleado[]
  batchesPago        BatchPago[]
  evidencias         EvidenciaCierre[]

  // El listado pagina por empresa ordenando fechaInicio desc — el compuesto
  // sirve filtro + ORDER BY de una vez (reemplaza al índice de empresaId sola).
  @@index([empresaId, fechaInicio(sort: Desc)])
}

// Qué empleados quedan incluidos en un periodo — se autopuebla con los
// activos al crear el periodo (mismo comportamiento implícito de antes de
// esta tabla) y la empresa puede des/marcar mientras el periodo esté en
// "borrador" (editarEmpleadosPeriodo). liquidarPeriodo liquida SOLO estos.
model PeriodoNominaEmpleado {
  periodoId  Int
  periodo    PeriodoNomina @relation(fields: [periodoId], references: [id])
  empleadoId Int
  empleado   Empleado      @relation(fields: [empleadoId], references: [id])

  @@id([periodoId, empleadoId])
  @@index([empleadoId])
}

// Insumo de la calculadora por turnos — el motor deriva diurno/nocturno/
// dominical/extra a partir de fecha+horaInicio+horaFin; nada de eso se
// persiste aquí (SDD.md §07).
model Turno {
  id         Int           @id @default(autoincrement())
  empleadoId Int
  empleado   Empleado      @relation(fields: [empleadoId], references: [id])
  periodoId  Int
  periodo    PeriodoNomina @relation(fields: [periodoId], references: [id])
  fecha      String // YYYY-MM-DD
  horaInicio String // HH:mm
  horaFin    String // HH:mm

  @@index([empleadoId, periodoId])
  // Leer/guardar los turnos de un periodo completo consulta por periodoId
  // solo — el compuesto de arriba no sirve con empleadoId ausente.
  @@index([periodoId])
}

// Documento emitido (snapshot histórico) — no se recalcula al cambiar reglas.
// Pertenece a exactamente uno de empleado/contratista (CHECK en el SQL de
// la migración — un contratista de servicios no es Empleado, SDD §07).
model ReciboPago {
  id             Int           @id @default(autoincrement())
  empleadoId     Int?
  empleado       Empleado?     @relation(fields: [empleadoId], references: [id])
  contratistaId  Int?
  contratista    Contratista?  @relation(fields: [contratistaId], references: [id])
  periodoId      Int
  periodo        PeriodoNomina @relation(fields: [periodoId], references: [id])
  lineas         Json // [{ concepto, tipo, formula, referenciaLegal, cantidad?, valor }]
  // string[] — advertencias del ResultadoNomina del motor en el momento de
  // liquidar (ej. preaviso/indemnización para término no indefinido, IBC de
  // tiempo parcial). Antes se descartaban al persistir el recibo.
  advertencias   Json          @default("[]")
  totalDevengado Float
  totalDeducido  Float
  neto           Float
  // IssueQA[] del motor de QA (SDD §15). Solo se pobla si el recibo se
  // liquidó "con_advertencias" (rechazada bloquea la liquidación antes de
  // persistir). null = QA aprobada / recibo pre-QA.
  qaIssues       Json?
  liquidadoEn    DateTime      @default(now())

  reportes ReporteDiscrepancia[]

  @@unique([empleadoId, periodoId])
  @@unique([contratistaId, periodoId])
  // Recibos de un periodo (listado, PILA, batch de pago, worker) consultan
  // por periodoId solo; los únicos de arriba solo sirven con el primer campo.
  @@index([periodoId])
}

// Bitácora inmutable de cambios sensibles (SDD §15, pilar 1). Poblada por
// trigger PL/pgSQL sobre ReciboPago/PeriodoNomina/Empleado (INSERT/UPDATE/
// DELETE). El usuarioId viene del setting de sesión `app.usuario_actual`
// que setea `conAuditoria()` en la transacción del service — auth.uid() es
// NULL con la conexión superusuaria de Prisma (documentado en la migración).
// La "inmutabilidad" se refuerza vía RLS/GRANT en la migración; en el
// entorno actual la app conecta como superusuario y sí puede escribir —
// esa doble capa protege futuros clientes vía roles authenticated de
// Supabase (mismo criterio que el resto de RLS del proyecto).
model AuditoriaCambio {
  id                BigInt   @id @default(autoincrement())
  empresaId         Int?
  usuarioId         String?  @db.Uuid
  tabla             String
  registroId        String
  accion            String // INSERT | UPDATE | DELETE
  valoresAnteriores Json?
  valoresNuevos     Json?
  creadoEn          DateTime @default(now())

  @@index([empresaId, creadoEn])
  @@index([tabla, registroId])
}

model ReporteDiscrepancia {
  id               Int        @id @default(autoincrement())
  reciboId         Int
  recibo           ReciboPago @relation(fields: [reciboId], references: [id])
  colaboradorId    String     @db.Uuid
  colaborador      Usuario    @relation(fields: [colaboradorId], references: [id])
  tipo             String // pago_de_mas | pago_de_menos | concepto_faltante
  detalle          String
  estado           String     @default("abierto") // abierto | en_revision | resuelto
  respuestaEmpresa String?
  creadoEn         DateTime   @default(now())

  @@index([reciboId])
}

// Lote de pago on-chain NO-CUSTODIAL (SDD §17): NomiCheck calcula el lote
// (contratistas con wallet + netos convertidos a USDC con tasa congelada) y
// genera los artefactos de firma (links EIP-681 + Safe batch JSON); el
// EMPLEADOR firma desde su propia wallet — el servidor jamás tiene llaves
// privadas ni toca fondos. La verificación del txHash contra el RPC de Base
// (logs Transfer del contrato USDC) cierra el ciclo: batch `verificado` →
// periodo `pagado`. Fase 1: SOLO contratistas (Ley 1819/2016 — pago
// comercial); los salarios de Empleado se pagan en COP (CST art. 134-136).
model BatchPago {
  id           Int           @id @default(autoincrement())
  empresaId    Int
  periodoId    Int
  periodo      PeriodoNomina @relation(fields: [periodoId], references: [id])
  // generado | expirado | verificado | fallido_verificacion
  estado       String        @default("generado")
  // Red/token modelados desde día 1 aunque fase 1 solo acepte
  // { red: "base", token: "USDC" } (validación estricta en pagosService).
  // tokenAddress = USDC NATIVO de Circle en Base (no USDbC bridged).
  red          String
  token        String
  tokenAddress String
  // { trm, fuente, fechaTrm, primaPct, tasaEfectiva, hash } — el hash sha256
  // del snapshot canónico se cita en el export para trazabilidad de la tasa.
  tasaSnapshot Json
  totalCop     Float
  totalUsdc    Float // 6 decimales USDC
  txHash       String?
  generadoEn   DateTime      @default(now())
  // La tasa congelada solo vale durante la ventana (pago_onchain_ventana_horas,
  // default 6h) — un lote vencido se regenera con tasa fresca, nunca se firma.
  expiraEn     DateTime
  verificadoEn DateTime?
  items        PagoItem[]

  @@index([empresaId])
  @@index([periodoId])
}

model PagoItem {
  id            Int       @id @default(autoincrement())
  batchId       Int
  batch         BatchPago @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reciboId      Int // ReciboPago del contratista que origina este pago
  destinoWallet String
  montoCop      Float
  montoUsdc     Float // 6 decimales

  @@index([batchId])
}

// La evidencia de un cierre de periodo, y la unidad de lo que se le cobra a una
// empresa (`services/medidorCierres.ts`, que tiene la tabla de precios).
//
// Se escribe UNA vez por cierre terminal que produjo recibos, dentro de la misma
// transacción que marca el periodo — si el cierre se revierte a borrador y se
// vuelve a cerrar, se escribe otra fila. Eso NO cobra dos veces: la factura es
// por mes y no por cierre, así que reliquidar suma filas y no montos.
//
// `payload` se guarda entero, y no solo su hash, porque el guard que importa es
// **verificar** la firma antes de facturar: sin el payload original solo se
// podría comprobar que el hash coincide consigo mismo. Son ~200 bytes por
// cierre.
model EvidenciaCierre {
  id           Int           @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  periodoId    Int
  periodo      PeriodoNomina @relation(fields: [periodoId], references: [id])
  // Mes calendario COLOMBIANO (YYYY-MM) en que ocurrió el cierre. Se congela al
  // escribir y no se deriva después de `creadoEn`: un cierre del 31 a las 9 de
  // la noche en Bogotá es 1 de septiembre en UTC, y recalcularlo en otra zona
  // le movería el mes —y a veces la banda— a la empresa.
  mes          String
  // Cuántos empleados/contratistas quedaron con recibo. Es lo que fija la banda,
  // y no el total de la empresa: no se cobra por gente para la que no se produjo
  // evidencia.
  conEvidencia Int
  estadoCierre String // liquidado | liquidado_con_rechazos
  payload      Json
  firma        Json // FirmaBatch: { algo, valor, publicKeyId, cubreCampos, canonical }
  creadoEn     DateTime      @default(now())

  // El estado de cuenta consulta siempre por (empresa, mes).
  @@index([empresaId, mes])
  @@index([periodoId])
}
