generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReglaLegal {
  id           Int      @id @default(autoincrement())
  clave        String
  valor        Float
  vigenteDesde String   // ISO date YYYY-MM-DD
  vigenteHasta String?
  fuente       String?
  creadoEn     DateTime @default(now())

  @@index([clave, vigenteDesde])
}

model Festivo {
  id     Int    @id @default(autoincrement())
  fecha  String @unique // YYYY-MM-DD
  nombre String
}

// Perfil de dominio 1:1 con auth.users de Supabase (id = mismo UUID).
// La identidad/credenciales viven en Supabase Auth, no aquí (SDD.md §07).
model Usuario {
  id        String  @id @db.Uuid
  nombre    String
  // Correo denormalizado desde Supabase Auth (allí viven las credenciales) —
  // permite buscar la cuenta por correo al invitar sin paginar todo Auth.
  email     String? @unique
  rol       String // admin_plataforma | admin_empresa | colaborador | individual
  // Empresa activa actual (puntero denormalizado). Null = sin empresa: recién
  // registrado admin_plataforma, o colaborador libre entre empresas.
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // Una cuenta se liga a varios Empleado a lo largo del tiempo (historial de
  // empresas) — solo uno "activo aceptado" a la vez (índice único parcial en
  // la migración). Ver invitacionAceptadaEn en Empleado.
  empleados         Empleado[]          @relation("EmpleadoUsuario")
  reportes          ReporteDiscrepancia[]
  liquidaciones     Liquidacion[]
  creadoEn          DateTime            @default(now())

  @@index([empresaId])
}

// Liquidación guardada por un usuario en su historial personal (flujo de
// "delayed auth" del verificador anónimo, SDD §13). Es un SNAPSHOT del
// ResultadoNomina calculado — no se recalcula al cambiar reglas, igual que
// ReciboPago. No pertenece a una empresa: la guarda una cuenta individual
// (o cualquier usuario autenticado) sobre su propio cálculo.
model Liquidacion {
  id           Int      @id @default(autoincrement())
  usuarioId    String   @db.Uuid
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  resultado    Json // ResultadoNomina completo (snapshot)
  netoEsperado Float // denormalizado desde resultado, para listar sin parsear el JSON
  netoRecibido Float? // lo que el usuario dijo haber recibido, si lo ingresó
  periodoDesde String? // YYYY-MM-DD, desde el snapshot
  periodoHasta String? // YYYY-MM-DD, desde el snapshot
  creadoEn     DateTime @default(now())

  @@index([usuarioId])
}

model Empresa {
  id       Int    @id @default(autoincrement())
  nombre   String
  nit      String @unique
  sector   String
  creadoEn DateTime @default(now())
  // Suspender bloquea de verdad el acceso (403 en requiereAuth) para
  // admin_empresa y colaboradores de esta empresa — admin_plataforma sigue
  // viendo/reactivando la empresa sin problema (SDD.md §03 Módulo D).
  activa   Boolean @default(true)

  usuarios     Usuario[]
  empleados    Empleado[]
  contratistas Contratista[]
  periodos     PeriodoNomina[]
}

model Empleado {
  id                Int      @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  // FK a la cuenta que reclama este registro. NO es único: una cuenta puede
  // aparecer en varios Empleado (distintas empresas / épocas). La unicidad
  // "una empresa activa por cuenta" la impone un índice parcial en la migración.
  usuarioId         String?  @db.Uuid
  usuario           Usuario? @relation("EmpleadoUsuario", fields: [usuarioId], references: [id])
  // Null con usuarioId seteado = invitación PENDIENTE (cuenta existente aún sin
  // aceptar). Con fecha = ACEPTADA (o vínculo directo de cuenta nueva). Doble
  // uso como auditoría de cuándo se unió.
  invitacionAceptadaEn DateTime?
  nombre            String
  documento         String
  salarioBase       Float
  tipoNomina        String // turnos | fijo
  auxilioTransporte Boolean @default(false)
  fechaIngreso      String // YYYY-MM-DD — base de antigüedad para prestaciones sociales
  fechaRetiro       String? // YYYY-MM-DD — si está seteada, el empleado puede liquidarse (prestacionesService)
  // indefinido (default) | fijo | obra_labor | tiempo_parcial | aprendizaje_sena_lectiva |
  // aprendizaje_sena_practica — ver TipoContrato en @pv/reglas.
  // "servicios" NO se modela aquí: no es contrato laboral (SDD §07).
  tipoContrato      String  @default("indefinido")
  // Clase de riesgo laboral ARL (I a V, Decreto 1772 de 1994) — 1 = riesgo
  // mínimo (oficinas/comercio). Antes solo existía como parámetro de
  // cálculo con default silencioso a 1 para todos; persistirla por
  // empleado es lo que hace "exacta" la liquidación PILA (packages/reglas
  // costoEmpleador.ts, calcularLiquidacionPilaEmpleado).
  claseRiesgoArl    Int     @default(1)
  activo            Boolean @default(true)
  creadoEn          DateTime @default(now())

  turnos  Turno[]
  recibos ReciboPago[]
  periodosIncluido PeriodoNominaEmpleado[]

  @@unique([empresaId, documento])
  @@index([empresaId])
}

// Contratista de prestación de servicios (Ley 1819 de 2016, art. 244) — NO
// es Empleado: no tiene contrato laboral, así que no tiene fechaIngreso/
// tipoNomina/auxilio ni genera prestaciones sociales (SDD §07).
model Contratista {
  id                  Int      @id @default(autoincrement())
  empresaId           Int
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  nombre              String
  documento           String
  honorariosMensuales Float
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now())

  recibos ReciboPago[]

  @@unique([empresaId, documento])
  @@index([empresaId])
}

model PeriodoNomina {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  fechaInicio String // YYYY-MM-DD
  fechaFin    String // YYYY-MM-DD
  estado      String   @default("borrador") // borrador | liquidado | pagado
  creadoEn    DateTime @default(now())
  // Rastro de auditoría de la última edición de fechas (solo se permite en
  // borrador — un periodo liquidado se revierte primero). Null = nunca editado.
  notaEdicion String?
  editadoEn   DateTime?

  turnos  Turno[]
  recibos ReciboPago[]
  empleadosIncluidos PeriodoNominaEmpleado[]

  @@index([empresaId])
}

// Qué empleados quedan incluidos en un periodo — se autopuebla con los
// activos al crear el periodo (mismo comportamiento implícito de antes de
// esta tabla) y la empresa puede des/marcar mientras el periodo esté en
// "borrador" (editarEmpleadosPeriodo). liquidarPeriodo liquida SOLO estos.
model PeriodoNominaEmpleado {
  periodoId  Int
  periodo    PeriodoNomina @relation(fields: [periodoId], references: [id])
  empleadoId Int
  empleado   Empleado      @relation(fields: [empleadoId], references: [id])

  @@id([periodoId, empleadoId])
  @@index([empleadoId])
}

// Insumo de la calculadora por turnos — el motor deriva diurno/nocturno/
// dominical/extra a partir de fecha+horaInicio+horaFin; nada de eso se
// persiste aquí (SDD.md §07).
model Turno {
  id          Int           @id @default(autoincrement())
  empleadoId  Int
  empleado    Empleado      @relation(fields: [empleadoId], references: [id])
  periodoId   Int
  periodo     PeriodoNomina @relation(fields: [periodoId], references: [id])
  fecha       String // YYYY-MM-DD
  horaInicio  String // HH:mm
  horaFin     String // HH:mm

  @@index([empleadoId, periodoId])
}

// Documento emitido (snapshot histórico) — no se recalcula al cambiar reglas.
// Pertenece a exactamente uno de empleado/contratista (CHECK en el SQL de
// la migración — un contratista de servicios no es Empleado, SDD §07).
model ReciboPago {
  id              Int           @id @default(autoincrement())
  empleadoId      Int?
  empleado        Empleado?     @relation(fields: [empleadoId], references: [id])
  contratistaId   Int?
  contratista     Contratista?  @relation(fields: [contratistaId], references: [id])
  periodoId       Int
  periodo         PeriodoNomina @relation(fields: [periodoId], references: [id])
  lineas          Json // [{ concepto, tipo, formula, referenciaLegal, cantidad?, valor }]
  // string[] — advertencias del ResultadoNomina del motor en el momento de
  // liquidar (ej. preaviso/indemnización para término no indefinido, IBC de
  // tiempo parcial). Antes se descartaban al persistir el recibo.
  advertencias    Json          @default("[]")
  totalDevengado  Float
  totalDeducido   Float
  neto            Float
  // IssueQA[] del motor de QA (SDD §15). Solo se pobla si el recibo se
  // liquidó "con_advertencias" (rechazada bloquea la liquidación antes de
  // persistir). null = QA aprobada / recibo pre-QA.
  qaIssues        Json?
  liquidadoEn     DateTime      @default(now())

  reportes ReporteDiscrepancia[]

  @@unique([empleadoId, periodoId])
  @@unique([contratistaId, periodoId])
}

model ReporteDiscrepancia {
  id               Int        @id @default(autoincrement())
  reciboId         Int
  recibo           ReciboPago @relation(fields: [reciboId], references: [id])
  colaboradorId    String     @db.Uuid
  colaborador      Usuario    @relation(fields: [colaboradorId], references: [id])
  tipo             String // pago_de_mas | pago_de_menos | concepto_faltante
  detalle          String
  estado           String     @default("abierto") // abierto | en_revision | resuelto
  respuestaEmpresa String?
  creadoEn         DateTime   @default(now())

  @@index([reciboId])
}
