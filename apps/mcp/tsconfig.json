{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Explícito desde TypeScript 7 (tsgo): acá la auto-inclusión de @types
    // dejó de ver `process` y `Buffer` — el compilador mismo sugiere esto.
    "types": ["node"],
    // `declaration` pasó a true el 2026-08-23: @pv/api importa este paquete
    // (INFO_SERVIDOR + el transporte HTTP) y sin .d.ts su typecheck no ve nada.
    "declaration": true,
    "declarationMap": false,
    // `allowJs` existe por un solo archivo: `src/vendor/sobre.mjs`, la copia
    // vendorizada del verificador. Es JavaScript plano a propósito (el original
    // se comprueba con `tsc --checkJs` sin instalar nada), y compilarlo acá lo
    // deja en `dist/` para que `node dist/index.js` funcione sin pasos extra.
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
